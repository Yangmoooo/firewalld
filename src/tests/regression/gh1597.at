FWD_START_TEST([reload with a timed runtime rule active])
AT_KEYWORDS([gh1597])

dnl cleanup() iterated _timeouts while removeTimeout() deleted from it, so a
dnl reload with any timed runtime object active raised "dictionary changed size
dnl during iteration" and left the daemon with no zones loaded.
FWD_CHECK([--zone public --add-port 12345/tcp --timeout 300], 0, [ignore])

FWD_RELOAD()

FWD_END_TEST()
